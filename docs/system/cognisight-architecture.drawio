<mxfile host="app.diagrams.net"><diagram id="cognisight" name="Local system"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1420" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;CogniSight · local system architecture&lt;/b&gt;" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="t2" value="Raspberry Pi 5 / 8 GB · one wearer · same-Wi-Fi caregiver · hardware acceptance pending" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#596579;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1450" height="25" as="geometry"/></mxCell><mxCell id="pi" value="&lt;b&gt;Raspberry Pi · one service process / ordinary user&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F2F6FC;strokeColor=#6B89B4;strokeWidth=1;fontSize=17;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=18;spacingTop=3;spacingRight=4;container=1;collapsible=0;pointerEvents=0;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="900" height="750" as="geometry"/></mxCell><mxCell id="t3" value="SENSORS / WEARER" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#596579;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="270" height="25" as="geometry"/></mxCell><mxCell id="t4" value="LOCAL ACCESS" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#596579;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1290" y="122" width="280" height="25" as="geometry"/></mxCell><mxCell id="camera" value="&lt;b&gt;Camera PCB V2.0 †&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;22 visible free-end contacts&lt;br&gt;Sensor / full cable compatibility unverified&lt;/font&gt;" style="rounded=