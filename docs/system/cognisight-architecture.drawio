red †&lt;br&gt;GPSD alone owns receiver&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="pi"><mxGeometry x="35" y="225" width="335" height="100" as="geometry"/></mxCell><mxCell id="navigation" value="&lt;b&gt;NavigationService&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Independent GPSD worker / reconnect&lt;br&gt;Location + status only · Sharanya&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="pi"><mxGeometry x="445" y="225" width="420" height="100" as="geometry"/></mxCell><mxCell id="aux" value="&lt;b&gt;Owned AUX headset / earphones&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;USB sound adapter required †&lt;br&gt;Mic + plug compatibility unverified †&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="505" width="270" height="130" as="geometry"/></mxCell><mxCell id="audio" value="&lt;b&gt;One AudioEngine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Vosk → commands / Piper → speech&lt;br&gt;Explicit USB routes · no speaker fallback&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="pi"><mxGeometry x="35" y="390" width="335" height="130" as="geometry"/></mxCell><mxCell id="snapshot" value="&lt;b&gt;Snapshot → allowlisted projection&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Original evidence age / independent GPS&lt;br&gt;No native or database work in HTTP&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="pi"><mxGeometry x="445" y="390" width="420" height="130" as="geometry"/></mxCell><mxCell id="private" value="&lt;b&gt;Private SQLite / profiles / models&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;State outside Git · no raw camera storage&lt;br&gt;Enrollment owns profile changes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="pi"><mxGeometry x="35" y="595" width="335" height="105" as="geometry"/></mxCell><mxCell id="dashboard" value="&lt;b&gt;Read-only caregiver backend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Waitress · 127.0.0.1:8766&lt;br&gt;Schema 1 · indoor unavailable&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="pi"><mxGeometry x="445" y="595" width="420" height="105" as="geometry"/></mxCell><mxCell id="enrollment" value="&lt;b&gt;Laptop → local enrollment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;SSH tunnel → Pi 127.0.0.1:8765&lt;br&gt;No LAN proxy / caregiver controls&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C4D3;strokeWidth=1;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="1"><mxGeometry x="1290" y="175" width="280" height="100" as="geometry