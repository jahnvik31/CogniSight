keColor=#D8E0EB;strokeWidth=1;fontSize=9;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="905" width="750" height="260" as="geometry"/></mxCell><mxCell id="t28" value="&lt;b&gt;Numbered paths&lt;/b&gt;" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="919" width="718" height="24" as="geometry"/></mxCell><mxCell id="t29" value="1  Camera frames → recognition / enrollment." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="954" width="718" height="24" as="geometry"/></mxCell><mxCell id="t30" value="2  Verified receiver † → GPSD → navigation (disabled now)." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="981" width="718" height="24" as="geometry"/></mxCell><mxCell id="t31" value="3  Recognition + outdoor → snapshot → dashboard." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1008" width="718" height="24" as="geometry"/></mxCell><mxCell id="t32" value="4  Phone ↔ Caddy HTTPS ↔ read-only backend." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1035" width="718" height="24" as="geometry"/></mxCell><mxCell id="t33" value="5  Headset mic † → USB adapter † → Vosk commands." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1062" width="718" height="24" as="geometry"/></mxCell><mxCell id="t34" value="6  Valid speech → one queue / Piper → AUX via USB †." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1089" width="718" height="24" as="geometry"/></mxCell><mxCell id="t35" value="7  Local enrollment ↔ profiles / SQLite → recognition." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1116" width="718" height="24" as="geometry"/></mxCell><mxCell id="contracts" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F5F7FB;strokeColor=#D8E0EB;strokeWidth=1;fontSize=9;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="1"><mxGeometry x="805" y="905" width="765" height="260" as="geometry"/></mxCell><mxCell id="t36" value="&lt;b&gt;Contracts / limits&lt;/b&gt;" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="919" width="733" height="24" as="geometry"/></mxCell><mxCell id="t37" value="Schema 1 · no images, embeddings or raw audio in API." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="954" width="733" height="24" as="geometry"/></mxCell><mxCell id="t38" value="Freshness: recognition &lt;1s; GPS &lt;10s by default (configurable)." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="981" width="733" height="24" as="geometry"/></mxCell><mxCell id="t39" value="Capture monotonic time ≠ response / inference completion time." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="1008" width="733" height="24" as="geometry"/></mxCell><mxCell id="t40" value="Last-known location is historical; UTC may be unavailable." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="1035" width="733" height="24" as="geometry"/></mxCell><mxCell id="t41" value="Queues: frame 1; speech 8; subscribers 8 × 64 (lossy events)." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="1062" width="733" height="24" as="geometry"/></mxCell><mxCell id="t42" value="Speech: explicit 1 / automatic 0; stop cancels generation." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="1089" width="733" height="24" as="geometry"/></mxCell><mxCell id="t43" value="Requested 640×480 / 15 fps is not measured throughput." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="1116" width="733" height="24" as="geometry"/></mxCell><mxCell id="limits" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F5F7FB;strokeColor=#D8E0EB;strokeWidth=1;fontSize=9;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="1185" width="1540" height="200" as="geometry"/></mxCell><mxCell id="t44" value="&lt;b&gt;Qualification / notation&lt;/b&gt;" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1199" width="1508" height="24" as="geometry"/></mxCell><mxCell id="t45" value="† Hardware path / identity is unverified; physical contributor must confirm it." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1234" width="1508" height="24" as="geometry"/></mxCell><mxCell id="t46" value="Solid black = data; dashed purple = control; dashed grey = disabled/unverified input." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1261" width="1508" height="24" as="geometry"/></mxCell><mxCell id="t47" value="Neutral shapes = local / non-AWS components. No cloud service is part of this design." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1288" width="1508" height="24" as="geometry"/></mxCell><mxCell id="t48" value="Indoor #5 deferred (Jahnvi / Archisha); no route guidance or emergency guarantee." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1315" width="1508" height="24" as="geometry"/></mxCell><mxCell id="t49" value="#7 actual Pi/camera/audio and #8 phone/TLS/load acceptance remain pending." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="1342" width="1508" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
